      {
        "id": "vlan-trunk-native",
        "order": 2,
        "title": "ضبط منافذ Trunk وNative VLAN",
        "subtitle": "حمل عدة VLANs عبر الوصلة نفسها",
        "source_page": 1,
        "explanation": {
          "label": "شرح خبير Cisco",
          "intro": "منافذ Trunk تُستخدم لنقل حركة أكثر من VLAN عبر وصلة واحدة، ويحدد الملف VLAN 99 كـ Native VLAN على النطاق FastEthernet0/1-5.",
          "points": [
            {
              "id": "interface-range",
              "text": "استخدم interface range لتطبيق الإعداد نفسه على مجموعة منافذ دفعة واحدة."
            },
            {
              "id": "trunk-mode",
              "text": "switchport mode trunk يحول المنافذ المحددة إلى منافذ Trunk."
            },
            {
              "id": "native-vlan",
              "text": "switchport trunk native vlan 99 يجعل VLAN 99 هي الـNative VLAN على هذه الوصلات."
            }
          ],
          "note": {
            "label": "ملاحظة خبير",
            "text": "الـNative VLAN ليست VLAN الوحيدة على منفذ Trunk؛ الـTrunk يمكنه حمل عدة VLANs، بينما الـNative VLAN ترتبط بالحركة غير الموسومة."
          }
        },
        "terminal": {
          "label": "S1",
          "commands": [
            {
              "id": "cmd-01",
              "order": 1,
              "prompt": "S1(config)#",
              "command": "interface range fastethernet 0/1-5",
              "description": "يحدد النطاق FastEthernet0/1 إلى FastEthernet0/5."
            },
            {
              "id": "cmd-02",
              "order": 2,
              "prompt": "S1(config-if-range)#",
              "command": "switchport mode trunk",
              "description": "يضبط المنافذ المحددة على وضع Trunk."
            },
            {
              "id": "cmd-03",
              "order": 3,
              "prompt": "S1(config-if-range)#",
              "command": "switchport trunk native vlan 99",
              "description": "يضبط VLAN 99 كـNative VLAN على منافذ الـTrunk."
            }
          ]
        }
