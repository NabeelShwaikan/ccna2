            {
              "id": "dot1q",
              "text": "encapsulation dot1q يربط كل Subinterface بمعرّف VLAN المناسب."
            },
            {
              "id": "gateway-addresses",
              "text": "يأخذ كل Subinterface عنوان 192.168.X.1 ليعمل كبوابة افتراضية لأجهزة VLAN المقابلة."
            }
