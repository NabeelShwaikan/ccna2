        "source_page": 5,
        "explanation": {
          "label": "شرح خبير Cisco",
          "intro": "تحقق من أن أسماء الأجهزة صحيحة وأن R1 G0/0 مفعلة، وأن عناوين SVI محفوظة. قد تبقى VLAN 99 غير قابلة للوصول حتى تكتمل مرحلة VLAN.",
          "points": [
            {
              "id": "running",
              "text": "show running-config يتحقق من hostname وإعدادات الإدارة."
            },
            {
              "id": "r1-interface",
              "text": "show ip interface brief على R1 يجب أن يظهر G0/0 مفعلة دون عنوان IPv4 مباشر قبل تكوين Subinterfaces."
            },
            {
              "id": "switch-svi",
              "text": "show ip interface brief على كل سويتش يعرض SVI VLAN 99 وعنوان الإدارة."
            },
            {
              "id": "gateway",
              "text": "show running-config | include default-gateway يتحقق من 192.168.99.1 على السويتشات."
            }
          ],
          "note": {
            "label": "ملاحظة",
            "text": "عدم نجاح ping على VLAN 99 في هذه المرحلة لا يعني خطأً بالضرورة إذا لم تُنفذ مرحلة VLAN/Trunk بعد."
          }
        },
        "terminal": {
