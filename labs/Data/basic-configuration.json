      {
        "id": "basic-router",
        "order": 3,
        "title": "التكوين الأساسي للراوتر R1",
        "subtitle": "اسم الجهاز وتجهيز G0/0 لـRouter-on-a-Stick",
        "source_page": 3,
        "explanation": {
          "label": "شرح خبير Cisco",
          "intro": "في السيناريو R1 يتصل بـSW1 عبر G0/0 ↔ F0/5. تُفعّل الواجهة الفيزيائية هنا دون عنوان IPv4 مباشر، لأن عناوين البوابات ستوضع على Subinterfaces في موضوع VLAN.",
          "points": [
            {
              "id": "hostname",
              "text": "اسم الراوتر المعتمد هو R1."
            },
            {
              "id": "physical-link",
              "text": "R1 G0/0 متصل بـSW1 F0/5."
            },
            {
              "id": "parent-interface",
              "text": "G0/0 واجهة Parent لـRouter-on-a-Stick ولا تحمل عنوان IPv4 مباشرًا في السيناريو."
            },
            {
              "id": "subinterfaces",
              "text": "عناوين 192.168.10.1 و192.168.20.1 و192.168.30.1 و192.168.99.1 تُنشأ لاحقًا على G0/0.10/.20/.30/.99."
            }
          ],
          "note": {
            "label": "منع التعارض",
            "text": "لا تنفذ ip address مباشرة على G0/0 في السيناريو؛ اكتفِ بتفعيلها ثم أكمل العناوين في موضوع VLAN."
          }
        },
        "terminal": {
          "label": "R1",
          "commands": [
            {
              "id": "cmd-01",
              "order": 1,
              "prompt": "Router>",
              "command": "enable",
              "description": "يدخل إلى Privileged EXEC."
            },
            {
              "id": "cmd-02",
              "order": 2,
              "prompt": "Router#",
              "command": "configure terminal",
              "description": "يدخل إلى Global Configuration."
            },
            {
              "id": "cmd-03",
              "order": 3,
              "prompt": "Router(config)#",
              "command": "hostname R1",
              "description": "يعتمد اسم الراوتر في السيناريو."
            },
            {
              "id": "cmd-04",
              "order": 4,
              "prompt": "R1(config)#",
              "command": "interface gigabitethernet 0/0",
              "description": "يدخل إلى المنفذ المتصل بـSW1 F0/5."
            },
            {
              "id": "cmd-05",
              "order": 5,
              "prompt": "R1(config-if)#",
