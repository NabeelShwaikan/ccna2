        },
        "terminal": {
          "label": "SW2 / SW3",
          "commands": [
            {
              "id": "cmd-01",
              "order": 1,
              "prompt": "SW2(config)#",
              "command": "interface range fastethernet 0/3-4",
              "description": "يحدد أعضاء Po3 على SW2."
