        "source_page": 1,
        "explanation": {
          "label": "شرح خبير Cisco",
          "intro": "القناة الثالثة في السيناريو تستخدم LACP. يبدأ SW2 التفاوض بوضع Active ويستجيب SW3 بوضع Passive.",
          "points": [
            {
              "id": "sw2",
              "text": "SW2 F0/3-4 ضمن channel-group 3 بوضع active."
            },
            {
              "id": "sw3",
              "text": "SW3 F0/3-4 ضمن channel-group 3 بوضع passive."
            },
            {
              "id": "pairing",
              "text": "Active مع Passive تكوين LACP متوافق ويكوّن القناة."
            }
          ],
          "note": {
            "label": "مطابق للسيناريو",
            "text": "لا تستخدم PAgP أوmode on على أعضاء Po3."
